---
import Base from "@/layouts/Base.astro";
import CustomButton from "@/components/CustomButton.astro";
---

<Base
  title="Pagina non trovata"
  metaDescription="La pagina che stai cercando non è disponibile."
  robots="noindex, follow"
  disableTagline={true}
  fitToScreen={false}>
  <section>
    <div class="container">
      <div class="flex flex-col items-center gap-y-10">
        <div class="space-y-4 text-center text-lg">
          <h1 class="text-8xl font-bold sm:text-9xl md:text-[16rem]">404</h1>
          <h2 class="text-h1-sm md:text-h1">Pagina non trovata</h2>
          <p>
            Il link che hai seguito potrebbe essere rotto o la pagina è stata rimossa.
          </p>
        </div>
        <CustomButton
          class="uppercase"
          label="Torna alla home"
          url="/"
          variant="text"
        />
      </div>
    </div>
  </section>
</Base>
