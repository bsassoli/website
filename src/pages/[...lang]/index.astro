---
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import BannerAgencyDark from "@/components/sections/BannerAgencyDark.astro";
import ServicesSection from "@/components/sections/ServicesSection.astro";
import AboutOne from "@/components/sections/AboutOne.astro";
import { generatePaths } from "@/lib/utils/languageParser.ts";

export function getStaticPaths() {
  return generatePaths();
}

const page = await getEntryCTM("homepage", "home", Astro.currentLocale);
---

<Base
  {...page?.data}
  hideOffcanvas={true}
  headerPosition="fixed"
  footerLayout={"footer-3"}
  hasHeaderDarkBackground={true}
  hasBodyDarkBackground={true}>
  <BannerAgencyDark />
  <ServicesSection />
  <AboutOne />
  <!-- TestimonialCreative: abilitare quando sono disponibili testimonianze reali -->
</Base>
