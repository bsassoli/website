---
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import BannerAgencyDark from "@/components/sections/BannerAgencyDark.astro";
import { generatePaths } from "@/lib/utils/languageParser.ts";
import CallToAction from "@/components/sections/CallToAction.astro";

export function getStaticPaths() {
  return generatePaths();
}

const page = await getEntryCTM("homepage", "home", Astro.currentLocale);
---

<Base
  {...page?.data}
  hideOffcanvas={true}
  headerPosition="fixed"
  footerLayout={"footer-3"}
  hasHeaderDarkBackground={true}
  hasBodyDarkBackground={true}>
  <BannerAgencyDark />
  <!-- <AboutTwo /> -->
  <!-- <ServicesSection /> -->
  <!-- <Clients /> -->
  <!-- <Features sectionSpaceTop={false} /> -->
  <!-- <Skills /> -->
  <!-- <PortfolioSection /> -->
  <!-- <TeamSection /> -->
  <!-- <TestimonialCreative /> -->
  <!-- <BlogSection /> -->
  <CallToAction content={page?.data.ctaSection} />
</Base>
